{
  "name": "htmlreview",
  "version": "0.1.0",
  "description": "Local web review for markdown and HTML documents — Claude Code skill for human-in-the-loop planning (W3C Web Annotation based)",
  "type": "module",
  "bin": {
    "htmlreview": "./bin/htmlreview.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "web/",
    "SKILL.md",
    "reviewer.md",
    "example.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node scripts/test-selector.mjs",
    "smoke": "node scripts/smoke.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "keywords": [
    "claude-code",
    "claude-code-skill",
    "markdown",
    "html",
    "review",
    "annotation",
    "web-annotation",
    "w3c",
    "human-in-the-loop"
  ],
  "author": "sangminnn",
  "license": "MIT",
  "homepage": "https://github.com/sangminnn/htmlreview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sangminnn/htmlreview.git"
  },
  "bugs": {
    "url": "https://github.com/sangminnn/htmlreview/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dom-anchor-text-position": "^4.0.2",
    "dom-anchor-text-quote": "^4.0.2",
    "marked": "^14.1.3",
    "sanitize-html": "^2.13.0"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  }
}
